# Anthropic API key (for house bot AI decisions)
ANTHROPIC_API_KEY=sk-ant-...

# Solana RPC endpoint (devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com

# WebSocket server port
WS_PORT=8081

# Set to "false" to run without on-chain transactions
USE_BLOCKCHAIN=false

# Set to "false" to disable built-in AI house bots
USE_HOUSE_BOTS=true
