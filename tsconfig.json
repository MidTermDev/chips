{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@engine/*": ["engine/*"],
      "@solana/*": ["solana/*"]
    }
  },
  "include": ["engine/**/*", "solana/**/*", "staking/**/*"],
  "exclude": ["node_modules", "dist", "web", "packages"]
}
